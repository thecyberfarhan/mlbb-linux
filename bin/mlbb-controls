#!/usr/bin/env python3
"""On-screen control bar for mlbb-linux: minimize / chat / game HUD buttons.

A layer-shell overlay at the mid-left of the game monitor. It never takes keyboard
focus and is shown only while the game overlay (scrcpy-mask) has focus (the
mlbb-focus KWin script prints "MLBB_FOCUS in/out" to the journal). Fully
transparent until the cursor hovers it.

  minimize  minimize the game (the KWin script minimizes Waydroid along with scrcpy-mask)
  chat      enter scrcpy-mask's typing mode by tapping a virtual Enter (/dev/uinput)
  game      leave typing mode via scrcpy-mask's own exit (hold virtual right-click
            >= 1s); reconnecting the device is only a fallback, because it can drop
            a held touch and leave the joystick stuck

The current mode is read from scrcpy-mask's log, so it stays correct however the
mode was changed. A watchdog releases touches Android still holds when nothing is
physically pressed. Everything machine-specific comes from the environment that
`mlbb` exports (MLBB_SERIAL, MLBB_MONITOR, MLBB_GAME_WIDTH/HEIGHT,
MLBB_SCRCPY_MASK_DIR, MLBB_WATCHDOG_IGNORE); sensible fallbacks apply if run alone.
"""
import fcntl
import glob
import json
import os
import struct
import subprocess
import sys
import threading
import time
import urllib.request

# Must be set before Qt creates the platform integration.
os.environ["QT_WAYLAND_SHELL_INTEGRATION"] = "layer-shell"

from PyQt6.QtCore import QObject, QSocketNotifier, QTimer, pyqtProperty, pyqtSignal, pyqtSlot  # noqa: E402
from PyQt6.QtGui import QGuiApplication  # noqa: E402
from PyQt6.QtQml import QQmlApplicationEngine  # noqa: E402


def _detect_serial():
    """Fall back to Waydroid's current IP if MLBB_SERIAL wasn't passed in."""
    try:
        out = subprocess.run(["waydroid", "status"], capture_output=True, text=True, timeout=5).stdout
        for line in out.splitlines():
            if "IP address" in line:
                ip = line.split("\t")[-1].strip()
                parts = ip.split(".")
                if len(parts) == 4 and all(p.isdigit() for p in parts):
                    return f"{ip}:5555"
    except (subprocess.SubprocessError, OSError):
        pass
    return ""


MONITOR = os.environ.get("MLBB_MONITOR", "")
SERIAL = os.environ.get("MLBB_SERIAL") or _detect_serial()
GAME_W = int(os.environ.get("MLBB_GAME_WIDTH", "1920"))
GAME_H = int(os.environ.get("MLBB_GAME_HEIGHT", "1080"))
MASK_DIR = os.environ.get("MLBB_SCRCPY_MASK_DIR") or os.path.expanduser("~/.local/share/scrcpy-mask/app")
ADB = os.path.join(MASK_DIR, "assets/platform-tools/adb")
MASK_BIN = os.path.join(MASK_DIR, "scrcpy-mask")
API = "http://127.0.0.1:27799/api"
STATE_DIR = os.path.expanduser(os.path.join(os.environ.get("XDG_STATE_HOME", "~/.local/state"), "mlbb"))
MASK_LOG = os.path.expanduser("~/.local/share/com.akichase.scrcpy-mask/app.log")
MLBB_BIN = os.path.expanduser("~/.local/bin/mlbb")

# Input devices the stuck-touch watchdog must never count as "a key is held":
# virtual devices (ours and others') can sit with a key bit set forever and would
# otherwise block the watchdog. Matched as case-insensitive substrings of the
# device name, plus anything in MLBB_WATCHDOG_IGNORE.
VIRTUAL_DEVICE_HINTS = ["uinput", "rustdesk", "mouce", "mlbb-controls", "ydotool", "virtual"]
VIRTUAL_DEVICE_HINTS += [s for s in os.environ.get("MLBB_WATCHDOG_IGNORE", "").lower().split() if s]

QML = r"""
